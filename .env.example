REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_GOOGLE_DRIVE_API_KEY=
REACT_APP_GOOGLE_DRIVE_UPLOAD_ENDPOINT=
REACT_APP_SENTRY_DSN=
REACT_APP_PUBLIC_APP_URL=

# Push notifications (Web Push VAPID)
# Generate keys: node scripts/generate-vapid-keys.js
# Private key lives in Supabase project secrets. Never expose it client-side.
# Public key is safe for the browser.
REACT_APP_VAPID_PUBLIC_KEY=

# Email — Gmail relay (Vercel serverless function)
# These secrets are set in the Vercel dashboard under Project > Settings > Environment Variables.
# NEVER put them in REACT_APP_* or expose them client-side.
# GMAIL_USER=club-sender@example.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   (Google App Password, NOT your normal Gmail password)
# EMAIL_RELAY_SECRET=<random 32-char token shared with Supabase>
#
# The following secrets are set in Supabase project secrets (Dashboard > Edge Functions > Secrets):
# EMAIL_RELAY_URL=https://<your-vercel-app>.vercel.app/api/email-relay
# EMAIL_RELAY_SECRET=<same token as above>
# EMAIL_FROM=BLW York Hub <club-sender@example.com>
#
# Legacy fallback providers (checked after relay; not needed if Gmail relay is configured):
# Supabase secrets: RESEND_API_KEY or SENDGRID_API_KEY

# Zoom
# Zoom credentials live in Supabase project secrets:
# ZOOM_ACCOUNT_ID, ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET
