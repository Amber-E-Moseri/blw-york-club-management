{
  "name": "blw-york-portal",
  "homepage": "/hub",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.44.0",
    "nodemailer": "^10.0.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^13.0.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "react-scripts": "5.0.1",
    "sharp": "^0.35.5",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^4.9.5",
    "undici": "5.28.4",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run build:unified",
    "test": "react-scripts test --watchAll=false --coverage --collectCoverageFrom='src/**/*.{ts,tsx}' --collectCoverageFrom='!src/**/__tests__/**' --collectCoverageFrom='!src/**/*.d.ts' --collectCoverageFrom='!src/index.tsx'",
    "test:watch": "react-scripts test",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:production": "playwright test -c playwright.production.config.ts",
    "eject": "react-scripts eject",
    "test:scripts": "node --test scripts/__tests__/seed-guard.test.cjs scripts/__tests__/hub-service-worker.test.cjs scripts/__tests__/supabase-config.test.cjs scripts/__tests__/migration-eol.test.cjs",
    "test:db:authz": "node supabase/verification/remediation_wave1_authz_pglite.mjs",
    "test:db:attendance": "node supabase/verification/attendance_schema_pglite.mjs",
    "test:db:membership": "node supabase/verification/membership_reconciliation_pglite.mjs",
    "build:hub": "react-scripts build",
    "build:site": "npm --prefix site install --no-audit --no-fund && npm --prefix site run build",
    "build:unified": "node scripts/check-supabase-config.mjs && npm run build:site && npm run build:hub && node scripts/assemble-unified.mjs",
    "verify:routes": "node scripts/verify-unified-routes.mjs",
    "test:db:website": "node supabase/verification/website_cms_authz_pglite.mjs && node supabase/verification/website_roles_pglite.mjs && node supabase/verification/website_roles059_pglite.mjs",
    "test:db:contract": "node supabase/verification/generate_pglite_fingerprint.mjs /tmp/blw-fingerprint-pglite.json && node supabase/verification/check_schema_contract.mjs /tmp/blw-fingerprint-pglite.json",
    "test:db:reconciliation": "node supabase/verification/reconciliation/bsc_scoped_pglite.mjs && node supabase/verification/reconciliation/profile_boundary_pglite.mjs && node supabase/verification/reconciliation/audience_pglite.mjs && node supabase/verification/reconciliation/profile_sync_pglite.mjs && node supabase/verification/reconciliation/bsc_leader_scope_pglite.mjs && node supabase/verification/reconciliation/assignments_pglite.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
